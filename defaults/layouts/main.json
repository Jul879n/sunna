{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "resizable": false,
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "size": {
        "px": 44
      },
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 268
          },
          "window_drag": true,
          "content": {
            "native": "brand"
          }
        },
        {
          "id": "tabs",
          "type": "block",
          "window_drag": true,
          "content": {
            "native": "tabs"
          }
        }
      ]
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 268
          },
          "min": 160,
          "max": 480,
          "background": "chrome",
          "resizable": false,
          "children": [
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "native": "spaces"
                  }
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 101
              },
              "content": {
                "native": "sidebar-footer"
              }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "background": "chrome",
          "resizable": false,
          "children": [
            {
              "id": "work-body",
              "type": "row",
              "padding": 8,
              "gap": 8,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 32,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "native": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "native": "changes"
                          }
                        },
                        {
                          "id": "search",
                          "type": "block",
                          "content": {
                            "native": "search"
                          }
                        },
                        {
                          "id": "bots",
                          "type": "block",
                          "content": {
                            "native": "bots"
                          }
                        },
                        {
                          "id": "activity",
                          "type": "block",
                          "content": {
                            "native": "activity"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "status",
              "type": "block",
              "size": {
                "px": 28
              },
              "content": {
                "native": "status"
              }
            }
          ]
        }
      ]
    }
  ]
}
