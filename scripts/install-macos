#!/bin/bash
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

app="/Applications/Sunna.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running Sunna.
cp target/release/sunna "$app/Contents/MacOS/Sunna.new"
mv -f "$app/Contents/MacOS/Sunna.new" "$app/Contents/MacOS/Sunna"
chmod +x "$app/Contents/MacOS/Sunna"
cp assets/icons/Herdr.icns "$app/Contents/Resources/Sunna.icns"

cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Sunna</string>
    <key>CFBundleIdentifier</key><string>dev.sunna.app</string>
    <key>CFBundleName</key><string>Sunna</string>
    <key>CFBundleDisplayName</key><string>Sunna</string>
    <key>CFBundleIconFile</key><string>Sunna</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Sunna can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Sunna can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Sunna can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; hc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
rm -f "$HOME/.local/bin/sunna"
printf '#!/bin/sh\n# sunna cli launcher\nexec "%s" "$@"\n' "$app/Contents/MacOS/Sunna" > "$HOME/.local/bin/sunna"
chmod 755 "$HOME/.local/bin/sunna"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen Sunna to use the new build."
