#!/bin/bash
# Builds a release of the app for this machine and packs it:
#
#   scripts/package            -> dist/sunna-<os>-<arch>.tar.gz
#   scripts/package <triple>   -> the same for another supported Rust target
#
# Linux: a folder holding sunna and the icon.
# macOS: Sunna.app, signed with APPLE_CERTIFICATE_P12 when available,
# otherwise ad hoc. The notarized DMG is a separate, non-blocking CI job.
# Windows (Git Bash): a folder holding sunna.exe and the icon.
# Windows has curl and tar too, so the app updates the same way.
# No core inside: the installer and the app install the core's own release
# (distribution/core-version is the oldest core this app works with).
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
else
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $(uname -s)" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
target="$os-$arch"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: sunna $version for $target"
for notice in LICENSE THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done
# Only release builds update themselves (src/update.rs).
# PACKAGE_FORK=1 builds without the flag, so the fork's build has no upstream
# telemetry/feedback endpoints (option_env! treats an empty var as set, hence env -u).
if [[ ${PACKAGE_FORK:-} == 1 ]]; then
  env -u HERDR_APP_RELEASE cargo build --release --locked ${triple:+--target "$triple"}
else
  HERDR_APP_RELEASE=1 cargo build --release --locked ${triple:+--target "$triple"}
fi

if [[ $os == linux ]]; then export TMPDIR=${TMPDIR:-/var/tmp}; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
out="dist/sunna-$target.tar.gz"
if [[ $os == linux || $os == windows ]]; then
  dir="$work/sunna"
  mkdir -p "$dir"
  if [[ $os == windows ]]; then cp "$bin/sunna.exe" "$dir/"; else cp "$bin/sunna" "$dir/"; fi
  cp assets/icons/herdr-ui-icon-clean.svg "$dir/sunna.svg"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  notices_path=sunna/THIRD-PARTY-NOTICES
  tar -czf "$out" -C "$work" sunna
else
  app="$work/Sunna.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/sunna" "$app/Contents/MacOS/Sunna"
  cp assets/icons/Herdr.icns "$app/Contents/Resources/Sunna.icns"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  notices_path=Sunna.app/Contents/Resources/THIRD-PARTY-NOTICES
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Sunna</string>
    <key>CFBundleIdentifier</key><string>dev.sunna.app</string>
    <key>CFBundleName</key><string>Sunna</string>
    <key>CFBundleDisplayName</key><string>Sunna</string>
    <key>CFBundleIconFile</key><string>Sunna</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Sunna can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Sunna can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Sunna can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
  scripts/mac-sign "$app"
  tar -czf "$out" -C "$work" Sunna.app
fi
tar -xOf "$out" "$notices_path" | cmp - THIRD-PARTY-NOTICES
license_path="${notices_path%/*}/LICENSE"
tar -xOf "$out" "$license_path" | cmp - LICENSE
echo "package: $out ($(sha256 "$out"))"
