#!/usr/bin/env python3
"""Raises the patch version everywhere it is written and starts its CHANGELOG section.

Prints the new version. Used by .github/workflows/auto-version.yml; commit subjects since the
last tag come from `git log` (or from $BUMP_SUBJECTS, one per line, for tests).
"""
import datetime
import os
import re
import subprocess
import sys

def read(path):
    with open(path, encoding="utf8") as f:
        return f.read()

def write(path, text):
    with open(path, "w", encoding="utf8") as f:
        f.write(text)

manifest = read("Cargo.toml")
match = re.search(r'(?m)^(\[package\]\n(?:.*\n)*?version = ")(\d+)\.(\d+)\.(\d+)(")', manifest)
if not match:
    sys.exit("bump-version: no [package] version in Cargo.toml")
old = ".".join(match.group(i) for i in (2, 3, 4))
new = f"{match.group(2)}.{match.group(3)}.{int(match.group(4)) + 1}"
write("Cargo.toml", manifest[: match.start(2)] + new + manifest[match.end(4):])

lock = read("Cargo.lock")
lock, n = re.subn(r'(name = "sunna"\nversion = ")[^"]+(")', rf"\g<1>{new}\g<2>", lock)
if n != 1:
    sys.exit("bump-version: the sunna package is not in Cargo.lock")
write("Cargo.lock", lock)

notices = read("THIRD-PARTY-NOTICES")
write("THIRD-PARTY-NOTICES", re.sub(rf"(?m)^(\s+sunna ){re.escape(old)}$", rf"\g<1>{new}", notices))

if "BUMP_SUBJECTS" in os.environ:
    subjects = os.environ["BUMP_SUBJECTS"].splitlines()
else:
    last = subprocess.run(["git", "describe", "--tags", "--abbrev=0"], capture_output=True, text=True).stdout.strip()
    rng = f"{last}..HEAD" if last else "HEAD"
    subjects = subprocess.run(["git", "log", rng, "--no-merges", "--format=%s"], capture_output=True, text=True, check=True).stdout.splitlines()

sections = {"New": [], "Fixed": []}
for line in subjects:
    m = re.match(r"(feat|fix)(?:\([^)]*\))?!?: (.+)", line)
    if m:
        text = m.group(2)[0].upper() + m.group(2)[1:]
        sections["New" if m.group(1) == "feat" else "Fixed"].append(f"- {text}.")
block = f"## [{new}] - {datetime.date.today().isoformat()}\n\n"
for title, items in sections.items():
    if items:
        block += f"### {title}\n" + "\n".join(items) + "\n\n"
changelog = read("CHANGELOG.md")
first = changelog.index("\n## [")
write("CHANGELOG.md", changelog[: first + 1] + block.rstrip("\n") + "\n" + changelog[first:])
print(new)
